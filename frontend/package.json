{
  "name": "scheduler-ai",
  "productName": "Scheduler AI",
  "description": "Natural-language calendar assistant",
  "author": "Your Name",
  "version": "0.1.0",
  "private": true,
  "main": "build/electron.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:web": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "preelectron:dev": "node scripts/fix-electron-dev-signing.js",
    "electron:dev": "concurrently -k \"PORT=3001 BROWSER=none npm start\" \"wait-on tcp:3001 && electron .\"",
    "prebuild:backend": "node scripts/prebuild-backend.js",
    "prebuild:native": "node scripts/build-native.js",
    "prebuild:electron": "cp electron/main.js build/electron.js",
    "electron:build": "npm run prebuild:backend && npm run prebuild:native && npm run build:web && npm run prebuild:electron && electron-builder --mac && npm run postbuild:sign",
    "postbuild:sign": "node scripts/sign-macos.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.yourco.schedulerai",
    "productName": "Scheduler AI",
    "directories": {
      "buildResources": "electron"
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "dir",
          "arch": ["universal"]
        }
      ]
    },
    "files": [
      "electron/**/*",
      "!electron/secrets.js",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "electron/assets/native",
        "to": "native",
        "filter": ["**/*"]
      }
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@picovoice/porcupine-web": "^3.0.3",
    "@picovoice/porcupine-web-en-worker": "^2.1.7",
    "@picovoice/web-voice-processor": "^4.0.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.7.1",
    "react-scripts": "^5.0.1",
    "web-vitals": "^2.1.4"
  },
  "proxy": "http://127.0.0.1:5001",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}